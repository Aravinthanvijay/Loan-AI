# Application
APP_NAME=Loan Underwriting AI
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=loan_underwriting_db

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq API (Get your key from https://console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=Loan Underwriting AI

# File Upload
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# ML Model
MODEL_PATH=./backend/ml/artifacts/model.pkl
SCALER_PATH=./backend/ml/artifacts/scaler.pkl
FEATURE_NAMES_PATH=./backend/ml/artifacts/feature_names.json

# RAG
POLICY_PATH=./backend/policies/underwriting_policy.txt
EMBEDDINGS_PATH=./data/embeddings/policy_embeddings.pkl
FAISS_INDEX_PATH=./data/embeddings/faiss_index.bin

# Tesseract OCR (Windows path — update if installed elsewhere)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Business Rules
